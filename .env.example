# ============================
# Environment
# ============================
ENV=dev                                # dev / staging / prod
LOG_LEVEL=INFO
DEBUG=false

# ============================
# Database
# ============================
DATABASE_URL=postgresql+asyncpg://nexis:nexis_dev@localhost:5432/nexis
POSTGRES_USER=nexis
POSTGRES_PASSWORD=nexis_dev
POSTGRES_DB=nexis

# ============================
# Redis (Cache / Streams / Celery Broker)
# ============================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================
# Object Storage (dev: MinIO, prod: S3 / OSS)
# ============================
OSS_ENDPOINT=http://localhost:9000
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_BUCKET=nexis-dev
OSS_REGION=us-east-1
OSS_USE_SSL=false

# ============================
# Vector DB (Qdrant)
# ============================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================
# Model Gateway / LiteLLM (Mock by default)
# ============================
LITELLM_URL=http://localhost:4000
LITELLM_API_KEY=sk-mock-1234
LITELLM_MOCK=true
STEP_PERSONA_MAX_BUDGET_TOKENS=8000
AGENT_REACT_MAX_STEPS=6
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=

# ============================
# Tool Servers (MCP)
# ============================
TAVILY_API_KEY=
MCP_SEARCH_URL=http://localhost:7001
MCP_IMAGE_TOOLS_URL=http://localhost:7002
MCP_VIDEO_TOOLS_URL=http://localhost:7003
MCP_AUDIO_TOOLS_URL=http://localhost:7004
MCP_DOCUMENT_TOOLS_URL=http://localhost:7005
MCP_OSS_URL=http://localhost:7006
MCP_PLATFORM_PUBLISH_URL=http://localhost:7007
ALIYUN_ACCESS_KEY=
ALIYUN_SECRET_KEY=
ALIYUN_SMS_SIGN_NAME=NexisAI
ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXXXX
ALIYUN_OSS_BUCKET=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_TOKEN=

# ============================
# Authentication & Security
# ============================
JWT_SECRET=change_me_to_a_long_random_string_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
SMS_DEV_MODE=true                      # dev/test only; set false in staging/prod with real SMS credentials
SMS_OTP_TTL_SECONDS=300
LOCAL_GUEST_ACCESS=false               # core.ps1 enables guest dev session automatically

# ============================
# CORS & WebSockets
# ============================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WS_HEARTBEAT_SECONDS=30
SSE_HEARTBEAT_SECONDS=15

# ============================
# Sentry Monitoring (prod only)
# ============================
SENTRY_DSN=

# ============================
# Frontend
# ============================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
